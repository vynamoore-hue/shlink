{
  "name": "shortlink-video",
  "main": "./worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "goto.vidufav.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
